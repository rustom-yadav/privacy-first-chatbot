# ── App Settings ─────────────────────────────────────────────────────
APP_NAME=Privacy-First-Chatbot
DEBUG=False
PORT=8000

# ── AI Configuration (Local models via Ollama) ──────────────────────
# Note: When running via Docker Compose, this value is ignored
# and overridden by the OLLAMA_HOST value in the root .env file.
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Alternative embedding models (uncomment one):
# EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL=all-mpnet-base-v2

# ── Chunking ────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ── Retrieval Pipeline ──────────────────────────────────────────────
RETRIEVER_K=20
ENSEMBLE_TOP_N=15

# ── Session & History ───────────────────────────────────────────────
MAX_HISTORY_TURNS=10

# ── Security ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_QUERY_LENGTH=2000
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_UPLOAD=5/minute