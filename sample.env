# ── App Settings ─────────────────────────────────────────────────────
APP_NAME=Privacy-First-Chatbot
DEBUG=False
PORT=8000

# ── AI Configuration (Local models via Ollama) ──────────────────────
# Note: For Docker Compose, OLLAMA_HOST should be http://ollama:11434 not localhost.
OLLAMA_HOST=http://ollama:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking ────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ── Retrieval Pipeline ──────────────────────────────────────────────
RETRIEVER_K=20
ENSEMBLE_TOP_N=15

# ── Session & History ───────────────────────────────────────────────
MAX_HISTORY_TURNS=10

# ── Security ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_QUERY_LENGTH=2000

# ⚠️ VERY IMPORTANT FOR VPS DEPLOYMENT ⚠️
# Which URL will the user type in their browser to open your website?
# - If testing on your laptop: "http://localhost:3000"
# - If on VPS (no domain yet): "http://<YOUR_VPS_PUBLIC_IP>:3000"
# - If you have a real domain: "https://yourdomain.com"
# If you don't put the exact URL here, the API will block the frontend (CORS Error)!
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_UPLOAD=5/minute

# ── Client Settings ─────────────────────────────────────────────────
# For Docker Compose, this MUST be http://api:8000
# If running client locally without Docker, use http://localhost:8000
NEXT_PUBLIC_API_URL=http://api:8000
